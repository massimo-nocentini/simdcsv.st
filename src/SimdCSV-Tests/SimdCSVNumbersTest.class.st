{ #category : 'asserting' }
SimdCSVNumbersTest >> assert: aString is: aFloat [
	| value |
	value := SimdCSVNumbers floatFrom: aString comma: false.
	self assert: (value isFloat and: [ value asIEEE64BitWord = aFloat asIEEE64BitWord ]) description: [
		aString printString , ' gives ' , value printString , ', not ' , aFloat printString ]
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testDigitsBeyondThePoint [
	"405 decimals of pi, zeros and ones beyond every rounding"

	| ones zeros |
	ones := String new: 401 withAll: $1.
	zeros := String new: 402 withAll: $0.
	self assert: self piWith405Decimals is: Float pi.
	self assert: '0.' , ones is: 0.1111111111111111.
	self assert: '1' , zeros , 'e-402' is: 1.0.
	self assert: '1.' , (String new: 401 withAll: $0) is: 1.0.
	self assert: '0.' , zeros , '1' is: 0.0.
	self assert: '0.' , zeros , '1e403' is: 1.0.
	self assert: '1' , zeros is: Float infinity
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testExponents [
	self assert: '1e400' is: Float infinity.
	self assert: '-1e400' is: Float infinity negated.
	self assert: '1e-400' is: 0.0.
	self assert: '-1e-400' is: Float negativeZero.
	self assert: '1e18446744073709551617' is: Float infinity.
	self assert: '1e-18446744073709551617' is: 0.0.
	self assert: '0e18446744073709551617' is: 0.0.
	self assert: '1e' , (String new: 10000 withAll: $9) is: Float infinity.
	self assert: '1e0000000000000000000000000000000000001' is: 10.0.
	self assert: '1e+5' is: 100000.0.
	self assert: '1E5' is: 100000.0
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testFloatGrammar [
	#( '' ' ' '.' '-' '+' '-.' 'e5' '.e5' '1e' '1e+' '1e1.0' '1..2' '1.2.3' '--1' '+-1' '1 2' '0x10' '1,5' 'nan' 'inf' 'infinity' '16r1F' '1_000' '1d5' '1q5' 'abc'
	   '1.5s2' ) do: [ :each |
		self assert: (SimdCSVNumbers floatFrom: each comma: false) isNil description: each ].
	#( '1.' 1.0 '.5' 0.5 '+1' 1.0 '-1.5' -1.5 ' 1.5 ' 1.5 '00012' 12.0 '1.50e1' 15.0 ) pairsDo: [ :text :value | self assert: text is: value ].
	self assert: (String with: Character tab) , '2' , (String with: Character tab) is: 2.0
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testFloatVectors [
	self class floats pairsDo: [ :text :bits |
		| value |
		value := SimdCSVNumbers floatFrom: text comma: false.
		self assert: value asIEEE64BitWord = bits description: [ text , ' gives ' , value printString ].
		value := SimdCSVNumbers floatFrom: '-' , (text copyReplaceAll: '.' with: ',') comma: true.
		self assert: value asIEEE64BitWord = (bits + (1 bitShift: 63)) description: [ '-' , text , ' gives ' , value printString ] ]
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testFloatWithComma [
	self assert: (SimdCSVNumbers floatFrom: '1,5' comma: true) equals: 1.5.
	self assert: (SimdCSVNumbers floatFrom: '1.5' comma: true) isNil.
	self assert: (SimdCSVNumbers floatFrom: ',5' comma: true) equals: 0.5
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testFloatsAreTheNearest [
	"No neighbour of the Float is nearer to the number, in exact arithmetic, and a tie is even"

	| random |
	random := self random.
	(self largeSize: 500) timesRepeat: [
		| digits exponent exact value error |
		digits := random nextInteger: (10 raisedTo: 1 + (random nextInteger: 24)).
		exponent := (random nextInteger: 660) - 345.
		exact := digits * (10 raisedTo: exponent).
		value := SimdCSVNumbers floatFrom: digits printString , 'e' , exponent printString comma: false.
		value isInfinite
			ifTrue: [ self assert: exact >= ((2 raisedTo: 1024) - (2 raisedTo: 970)) ]
			ifFalse: [
				error := (value asTrueFraction - exact) abs.
				{ value predecessor. value successor } do: [ :each |
					each isInfinite ifFalse: [
						self assert: error <= (each asTrueFraction - exact) abs description: digits printString , 'e' , exponent printString ] ] ] ]
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testHalfways [
	"The number half-way between two Floats, to the last digit: ties to even"

	#( 0 1 2 3 4503599627370495 4503599627370496 9007199254740991 4611686018427387905 9218868437227405310 ) do: [ :bits |
		| low high half text even |
		low := Float fromIEEE64Bit: bits.
		high := Float fromIEEE64Bit: bits + 1.
		half := (low asTrueFraction + high asTrueFraction) / 2.
		text := self decimalOf: half.
		even := bits even
			        ifTrue: [ low ]
			        ifFalse: [ high ].
		self assert: text is: even.
		self assert: (text copyUpTo: $e) , '.000000000000000000000001e' , (text copyAfter: $e) is: high ]
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testHalfwaysBeyondTheKeptDigits [
	"A half-way number and a digit far beyond the 800 that are kept"

	| half text exponent |
	half := (1.0 asTrueFraction + 1.0 successor asTrueFraction) / 2.
	text := self decimalOf: half.
	exponent := text copyAfter: $e.
	text := (text copyUpTo: $e) , '.' , (String new: 1000 withAll: $0).
	self assert: text , 'e' , exponent is: 1.0.
	self assert: text , '1e' , exponent is: 1.0 successor
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testIntegerGrammar [
	#( '' ' ' '-' '+' '--1' '1.0' '1e3' '12abc' '0x10' '1 2' '1_000' ) do: [ :each |
		self assert: (SimdCSVNumbers integerFrom: each) isNil description: each ].
	#( '0' 0 '-0' 0 '12' 12 '-12' -12 '+12' 12 ' 12 ' 12 '00012' 12 ) pairsDo: [ :text :value |
		self assert: (SimdCSVNumbers integerFrom: text) equals: value ].
	self assert: (SimdCSVNumbers integerFrom: (String with: Character tab with: $7)) equals: 7.
	self assert: (SimdCSVNumbers integerFrom: (WideString with: $4 with: $2)) equals: 42
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testIntegerDigits [
	| nines |
	#( 17 18 19 34 35 36 100 4300 ) do: [ :size |
		nines := String new: size withAll: $9.
		self assert: (SimdCSVNumbers integerFrom: nines) equals: (10 raisedTo: size) - 1.
		self assert: (SimdCSVNumbers integerFrom: '-' , nines) equals: 1 - (10 raisedTo: size) ].
	self assert: (SimdCSVNumbers integerFrom: nines , '9') isNil.
	self assert: (SimdCSVNumbers integerFrom: (String new: 5000 withAll: $0) , '7') equals: 7
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testRandomIntegers [
	| random |
	random := self random.
	(self largeSize: 1000) timesRepeat: [
		| integer |
		integer := (random nextInteger: (10 raisedTo: (random nextInteger: 60))) - (10 raisedTo: (random nextInteger: 30)).
		self assert: (SimdCSVNumbers integerFrom: integer printString) equals: integer ]
]

{ #category : 'tests' }
SimdCSVNumbersTest >> testZeros [
	#( '0' '0.0' '.0' '0.' '0e5' '000.000e-10' ) do: [ :each |
		self assert: each is: 0.0.
		self assert: '-' , each is: Float negativeZero ]
]

{ #category : 'helpers' }
SimdCSVNumbersTest >> decimalOf: aFraction [
	"The exact decimal text of aFraction, whose denominator is a power of two: an Integer and an exponent"

	| exponent |
	exponent := aFraction denominator highBit - 1.
	^ (aFraction numerator * (5 raisedTo: exponent)) printString , 'e' , exponent negated printString
]

{ #category : 'helpers' }
SimdCSVNumbersTest >> piWith405Decimals [
	^ '3.'
]
